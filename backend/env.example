# Compass -> ... next to your connection -> "Copy connection string", then put your real password in place of <db_password>
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ai_marketing
USE_MOCK_DB=false

# ---------- LLM ----------
LLM_PROVIDER=gemini

# Paste the key with NO quotes and NO spaces. GOOGLE_API_KEY also works as the name.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-pro

# Only needed if you switch LLM_PROVIDER
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------- App ----------
CORS_ORIGINS=http://localhost:5173

# ---------- Phase 3: AI image generation ----------
# mock   = offline placeholder images (no key, good for testing/demo)
# gemini = Gemini image model, uses GEMINI_API_KEY above (image generation may need a billing-enabled key)
# openai = gpt-image-1, uses OPENAI_API_KEY above
IMAGE_PROVIDER=mock
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_IMAGE_FALLBACK_MODELS=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
STORAGE_DIR=storage
