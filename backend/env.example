# Copy to backend/.env and fill in. NEVER commit backend/.env (it is in .gitignore).
# In production set these as environment variables in your host's dashboard instead of a file.

# ---------- Database (MongoDB Atlas) ----------
# Atlas -> Connect -> Drivers -> copy the string. Atlas Network Access must allow your host's IP (0.0.0.0/0 on free tier).
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ai_marketing
USE_MOCK_DB=false            # true = in-memory database for demos/tests

# ---------- LLM ----------
LLM_PROVIDER=gemini          # gemini | anthropic | openai | mock (mock = offline, no key)
GEMINI_API_KEY=              # no quotes, no spaces
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-pro
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------- Image generation ----------
IMAGE_PROVIDER=mock         # gemini | openai | mock
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_IMAGE_FALLBACK_MODELS=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
STORAGE_DIR=storage          # on a host: a persistent disk path, e.g. /data/storage
MAX_UPLOAD_MB=5

# ---------- App / security ----------
CORS_ORIGINS=http://localhost:5173      # comma separated; in production your public URL
ENVIRONMENT=development                 # production = HSTS on, /docs off, /api/metrics needs ADMIN_TOKEN
ADMIN_TOKEN=                            # long random string; send as X-Admin-Token to read /api/metrics
RATE_LIMIT_PER_MINUTE=30                # AI endpoints per IP; 0 = off (ignored while both providers are mock)
MAX_BODY_MB=12

# ---------- Cost control ----------
STRATEGY_CACHE_HOURS=72                 # same brief inside this window reuses the saved campaign (0 = off)

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_JSON=false                          # true on a host: one JSON line per log entry
LOG_FILE=                               # optional, e.g. logs/app.log (rotating)